# =============================================================================
# QueueLess Backend Environment Variables (.env.example)
# Rename this file to .env and configure your production credentials.
# NEVER commit your actual .env file with secrets into version control.
# =============================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# JWT Authentication Secrets
JWT_SECRET=queueless_super_secure_jwt_secret_key_2026_replace_in_production
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# ADMIN 2FA: Gmail SMTP Configuration (Option A)
# Generate a 16-character Google App Password via:
# Google Account -> Security -> 2-Step Verification -> App Passwords
# -----------------------------------------------------------------------------
GMAIL_USER=your_college_admin_email@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Optional Custom SMTP (if using college/institutional mail exchange instead of Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# -----------------------------------------------------------------------------
# ADMIN 2FA: Twilio SMS Configuration (Option B)
# Obtain credentials from your Twilio Console (https://console.twilio.com)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------------------------------------------------------
# OTP Security Policies
# -----------------------------------------------------------------------------
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# -----------------------------------------------------------------------------
# Admin Setup Security Key (Guards against public administrator registration)
# -----------------------------------------------------------------------------
ADMIN_SETUP_KEY=QueueLessAdmin2026!
